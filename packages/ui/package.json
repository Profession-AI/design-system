{
  "name": "@professionai/ui",
  "version": "3.0.0",
  "description": "ProfessionAI Design System — componenti React sui token canonici (shadcn/ui su Radix, Tailwind 4)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./ui/*": "./src/ui/*.tsx"
