{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "ProfessionAI Design System v2 — sorgente unica. Le scale 50–900 delle famiglie con $extensions.pai.scale=true sono generate da build.mjs miscelando il 500 verso bianco/nero (valori derivati, non ufficiali). Le decisioni sono in DECISIONS.md.",

  "color": {
    "black": { "$type": "color", "$value": "#000000" },
    "white": { "$type": "color", "$value": "#FFFFFF" },

    "teal":        { "$type": "color", "$value": "#00CCB2", "$description": "dark green — accento primario",       "$extensions": { "pai": { "scale": true, "overrides": { "400": "#19E8CA", "700": "#00A08C" } } } },
    "light-green": { "$type": "color", "$value": "#84FFBE", "$description": "highlight su scuro",                  "$extensions": { "pai": { "scale": true, "overrides": { "800": "#42805F" } } } },
    "purple":      { "$type": "color", "$value": "#8980F5", "$description": "espressivo: sfondi, glow, chart",      "$extensions": { "pai": { "scale": true } } },
    "orange":      { "$type": "color", "$value": "#F18F01", "$description": "espressivo: sfondi, glow, chart",      "$extensions": { "pai": { "scale": true } } },
    "blue":        { "$type": "color", "$value": "#1F99CD", "$description": "info + nome corso (decisione 7)",     "$extensions": { "pai": { "scale": true } } },
    "red":         { "$type": "color", "$value": "#F0454B", "$description": "SOLO danger (decisione 9)",           "$extensions": { "pai": { "scale": true } } },

    "neutral": {
      "$type": "color",
      "50":  { "$value": "#FAFAFA" }, "100": { "$value": "#F4F4F5" }, "200": { "$value": "#E4E4E7" },
      "300": { "$value": "#D4D4D8" }, "400": { "$value": "#A1A1AA" }, "500": { "$value": "#71717A" },
      "600": { "$value": "#52525B" }, "700": { "$value": "#3F3F46" }, "800": { "$value": "#27272A" },
      "900": { "$value": "#18181B" }, "950": { "$value": "#09090B" }
    },

    "site": {
      "$type": "color",
      "canvas":       { "$value": "#091314", "$description": "Decisione 1" },
      "panel-start":  { "$value": "#081112" },
      "panel-end":    { "$value": "#1A2223" },
      "footer":       { "$value": "#001310" },
      "orb-teal":     { "$value": "#4EB1B2" },
      "orb-purple":   { "$value": "#9C95F6" },
      "orb-orange":   { "$value": "#C87700" },
      "ring":         { "$value": "rgba(255,255,255,0.15)" },
      "ring-strong":  { "$value": "rgba(255,255,255,0.5)" },
      "glass":        { "$value": "rgba(255,255,255,0.05)" },
      "chip":         { "$value": "rgba(255,255,255,0.15)" }
    },

    "app": {
      "$type": "color",
      "shell-start":  { "$value": "#00443B" },
      "shell-end":    { "$value": "#010303" },
      "profai-start": { "$value": "#2F897C" },
      "profai-end":   { "$value": "#00231E" }
    }
  },

  "semantic": {
    "$description": "Alias di stato e superficie. Ogni valore punta a un token brand: mai un hex nuovo qui.",
    "status": {
      "success": { "$type": "color", "$value": "{color.teal.800}",   "$extensions": { "pai": { "bg": "{color.teal.50}",   "border": "{color.teal.200}" } } },
      "warning": { "$type": "color", "$value": "{color.orange.700}", "$extensions": { "pai": { "bg": "{color.orange.50}", "border": "{color.orange.200}" } } },
      "danger":  { "$type": "color", "$value": "{color.red.600}",    "$extensions": { "pai": { "bg": "{color.red.50}",    "border": "{color.red.200}" } } },
      "info":    { "$type": "color", "$value": "{color.blue.700}",   "$extensions": { "pai": { "bg": "{color.blue.50}",   "border": "{color.blue.200}" } } },
      "neutral": { "$type": "color", "$value": "{color.neutral.600}","$extensions": { "pai": { "bg": "{color.neutral.100}","border": "{color.neutral.200}" } } }
    },
    "text": {
      "course-name": { "$type": "color", "$value": "{color.blue}", "$description": "Alias storico: evidenzia il nome del master negli header." }
    }
  },

  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["General Sans", "Montserrat", "system-ui", "sans-serif"], "$description": "Solo registro marketing." },
      "product": { "$type": "fontFamily", "$value": ["Figtree", "Inter", "system-ui", "sans-serif"], "$description": "Registri learner e operational. Proxima Nova rimossa (decisione 13)." },
      "reading": { "$type": "fontFamily", "$value": ["Atkinson Hyperlegible", "Figtree", "system-ui", "sans-serif"], "$description": "Collaterale text-heavy." },
      "mono":    { "$type": "fontFamily", "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"], "$description": "Solo codice e ID tecnici, mai etichette." }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "12px" }, "sm": { "$value": "13px" }, "base": { "$value": "14px" },
      "md": { "$value": "16px" }, "lg": { "$value": "20px" }, "xl": { "$value": "24px" },
      "2xl": { "$value": "32px" }, "3xl": { "$value": "40px" }, "display": { "$value": "56px" }
    },
    "weight": { "$type": "fontWeight", "regular": { "$value": 400 }, "medium": { "$value": 500 }, "semibold": { "$value": 600 }, "bold": { "$value": 700 } },
    "lineHeight": { "$type": "number", "heading": { "$value": 1.1 }, "body": { "$value": 1.5 }, "dense": { "$value": 1.35 }, "display-site": { "$value": 1 } },
    "tracking": { "$type": "dimension", "heading": { "$value": "-0.033em" }, "normal": { "$value": "0" } }
  },

  "space": {
    "$type": "dimension",
    "0": { "$value": "0px" }, "1": { "$value": "4px" }, "2": { "$value": "8px" }, "3": { "$value": "12px" },
    "4": { "$value": "16px" }, "5": { "$value": "20px" }, "6": { "$value": "24px" }, "8": { "$value": "32px" },
    "10": { "$value": "40px" }, "12": { "$value": "48px" }, "16": { "$value": "64px" }
  },

  "radius": {
    "$type": "dimension",
    "xs": { "$value": "4px" }, "sm": { "$value": "8px" }, "md": { "$value": "12px" }, "lg": { "$value": "16px" },
    "xl": { "$value": "24px" }, "pill": { "$value": "999px" },
    "legacy": { "course-card": { "$value": "22.43px" }, "site-panel": { "$value": "40px" }, "$description": "Solo sito v1.3." }
  },

  "shadow": {
    "$type": "shadow",
    "$description": "Decisione 2. Solo registri learner/operational.",
    "sm": { "$value": { "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px", "color": "rgba(0,0,0,0.06)" } },
    "xl": { "$value": { "offsetX": "0px", "offsetY": "24px", "blur": "48px", "spread": "-12px", "color": "rgba(0,0,0,0.25)" } },
    "cta-bloom": { "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "50px", "spread": "0px", "color": "#B0AAF8" }, "$description": "Solo hero sito." }
  },

  "density": {
    "$description": "Decisione 12. Applicate come classi .pai-density-comfortable / .pai-density-compact.",
    "comfortable": { "row": { "$type": "dimension", "$value": "44px" }, "control": { "$type": "dimension", "$value": "40px" }, "cell-x": { "$type": "dimension", "$value": "16px" }, "font": { "$type": "dimension", "$value": "14px" } },
    "compact":     { "row": { "$type": "dimension", "$value": "36px" }, "control": { "$type": "dimension", "$value": "32px" }, "cell-x": { "$type": "dimension", "$value": "12px" }, "font": { "$type": "dimension", "$value": "13px" } }
  },

  "motion": {
    "duration": { "$type": "duration", "fast": { "$value": "150ms" }, "enter": { "$value": "225ms" }, "leave": { "$value": "195ms" }, "standard": { "$value": "300ms" } },
    "easing": { "$type": "cubicBezier", "enter": { "$value": [0.215, 0.61, 0.355, 1] }, "sidebar": { "$value": [0.455, 0.03, 0.515, 0.955] }, "reveal": { "$value": [0.65, 0, 0.35, 1] } }
  },

  "focus": {
    "$description": "Anello 2px con offset 2px, sempre visibile.",
    "width": { "$type": "dimension", "$value": "2px" },
    "offset": { "$type": "dimension", "$value": "2px" },
    "on-dark":  { "$type": "color", "$value": "{color.light-green}" },
    "on-light": { "$type": "color", "$value": "{color.teal.700}" },
    "product":  { "$type": "color", "$value": "{color.teal.400}" }
  },

  "layout": {
    "$type": "dimension",
    "sidebar-expanded": { "$value": "264px" }, "sidebar-collapsed": { "$value": "72px" },
    "topbar": { "$value": "56px" }, "content-max": { "$value": "1280px" }, "reading-max": { "$value": "680px" },
    "site-content": { "$value": "1110px" }
  },

  "chart": {
    "$description": "Decisione 10. Rosso mai. L'ordine categoriale è fisso: la serie 1 è sempre teal.",
    "categorical": { "$type": "color", "$value": ["{color.teal}", "{color.purple}", "{color.orange}", "{color.light-green.700}", "{color.blue}", "{color.teal.300}", "{color.purple.300}", "{color.orange.300}"] },
    "sequential":  { "$type": "color", "$value": ["{color.teal.100}", "{color.teal.200}", "{color.teal.300}", "{color.teal.400}", "{color.teal}", "{color.teal.600}", "{color.teal.700}", "{color.teal.800}"] },
    "diverging":   { "$type": "color", "$value": ["{color.purple.700}", "{color.purple}", "{color.purple.300}", "{color.neutral.200}", "{color.orange.300}", "{color.orange}", "{color.orange.700}"] },
    "grid":        { "$type": "color", "$value": "{color.neutral.200}" },
    "axis":        { "$type": "color", "$value": "{color.neutral.500}" }
  }
}
